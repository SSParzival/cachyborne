# Adapted from Supermedo/bloodborne_pc 2e887b84 (nick24051998).
# Paths and line endings are excluded so relocations/CRLF do not discard a valid cache.
function(bb_shader_fingerprint source_root output_file)
    set(sources ${ARGN})
    list(SORT sources)
    if(DEFINED BB_SHADER_CONFIGURATION_FILE)
        file(READ "${BB_SHADER_CONFIGURATION_FILE}" configuration)
        string(REPLACE "\r\n" "\n" configuration "${configuration}")
        # Generated options contain source/build paths (for example BB_FONT_PATH).
        # Normalize the build root first: it can be inside the source root.
        string(REPLACE "${BB_SHADER_BUILD_ROOT}" "<build>" configuration "${configuration}")
        string(REPLACE "${source_root}" "<source>" configuration "${configuration}")
        set(material "effective-shader-configuration-v2\n${configuration}\n")
    else()
        # Standalone script callers retain the small explicit configuration API.
        string(TOUPPER "${CMAKE_BUILD_TYPE}" build_type)
        set(material "${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_CXX_FLAGS}|${CMAKE_BUILD_TYPE}|${CMAKE_CXX_FLAGS_${build_type}}\n")
    endif()
    foreach(source IN LISTS sources)
        file(RELATIVE_PATH relative "${source_root}" "${source}")
        file(READ "${source}" contents)
        string(REPLACE "\r\n" "\n" contents "${contents}")
        string(SHA256 digest "${contents}")
        string(APPEND material "${relative}:${digest}\n")
    endforeach()
    string(SHA256 fingerprint "${material}")
    set(words "")
    foreach(index RANGE 0 7)
        math(EXPR offset "${index} * 8")
        string(SUBSTRING "${fingerprint}" ${offset} 8 word)
        string(APPEND words "0x${word}u,")
    endforeach()
    set(header "// Generated; source/ABI fingerprint of the shader compiler and pipeline cache.\n#pragma once\n#include <array>\n#include <cstdint>\nnamespace BbShaderBuild {\ninline constexpr char Id[] = \"${fingerprint}\";\ninline constexpr std::array<std::uint32_t, 8> Words{${words}};\n}\n")
    get_filename_component(output_dir "${output_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${output_dir}")
    file(WRITE "${output_file}.in" "${header}")
    configure_file("${output_file}.in" "${output_file}" COPYONLY)
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${sources})
    endif()
endfunction()

# Generate after target configuration, so usage requirements and generator
# expressions are evaluated by CMake rather than inferred from CMake source text.
# The header is updated only when its content changes, keeping dependent objects
# and the on-disk shader cache intact after unrelated target/test additions.
function(bb_target_shader_fingerprint target source_root output_file)
    cmake_parse_arguments(PARSE_ARGV 3 FP "" "" "SOURCES;DEPENDENCY_TARGETS")
    if(FP_UNPARSED_ARGUMENTS OR NOT FP_SOURCES)
        message(FATAL_ERROR "bb_target_shader_fingerprint requires SOURCES")
    endif()
    list(SORT FP_SOURCES)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -march=native -dM -E -x c++ /dev/null
        OUTPUT_VARIABLE native_macros RESULT_VARIABLE native_result ERROR_VARIABLE native_error)
    if(NOT native_result EQUAL 0)
        message(FATAL_ERROR "Cannot identify native compiler features: ${native_error}")
    endif()
    string(SHA256 native_features "${native_macros}")
    set(configuration "compiler=${CMAKE_CXX_COMPILER_ID}|${CMAKE_CXX_COMPILER_VERSION}|${CMAKE_CXX_COMPILER_TARGET}|${CMAKE_CXX_COMPILER_FRONTEND_VARIANT}\nsystem=${CMAKE_SYSTEM_NAME}|${CMAKE_SYSTEM_PROCESSOR}|${CMAKE_SIZEOF_VOID_P}\nnative-features=${native_features}\nconfiguration=$<CONFIG>\nglobal-flags=${CMAKE_CXX_FLAGS}\n")
    foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE)
        string(TOUPPER "${config}" upper)
        string(APPEND configuration "$<$<CONFIG:${config}>:configuration-flags=${CMAKE_CXX_FLAGS_${upper}}>\n")
    endforeach()
    foreach(compiler_target IN ITEMS ${target} ${FP_DEPENDENCY_TARGETS})
        if(NOT TARGET "${compiler_target}")
            message(FATAL_ERROR "Shader identity dependency target missing: ${compiler_target}")
        endif()
        string(APPEND configuration "target=${compiler_target}\n")
        foreach(property IN ITEMS COMPILE_OPTIONS COMPILE_DEFINITIONS COMPILE_FEATURES
                CXX_STANDARD CXX_EXTENSIONS POSITION_INDEPENDENT_CODE INTERPROCEDURAL_OPTIMIZATION)
            string(APPEND configuration "${property}=$<TARGET_GENEX_EVAL:${compiler_target},$<TARGET_PROPERTY:${compiler_target},${property}>>\n")
        endforeach()
        get_target_property(target_directory "${compiler_target}" SOURCE_DIR)
        get_directory_property(directory_definitions DIRECTORY "${target_directory}" COMPILE_DEFINITIONS)
        string(APPEND configuration "directory-definitions=$<TARGET_GENEX_EVAL:${compiler_target},${directory_definitions}>\n")
        foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES CMAKE_BUILD_TYPE)
            string(TOUPPER "${config}" upper)
            string(APPEND configuration "$<$<CONFIG:${config}>:IPO-override=$<TARGET_PROPERTY:${compiler_target},INTERPROCEDURAL_OPTIMIZATION_${upper}>>\n")
        endforeach()
        foreach(source IN LISTS FP_SOURCES)
            file(RELATIVE_PATH relative "${source_root}" "${source}")
            foreach(property IN ITEMS COMPILE_OPTIONS COMPILE_DEFINITIONS COMPILE_FLAGS INCLUDE_DIRECTORIES LANGUAGE)
                get_property(source_set SOURCE "${source}" TARGET_DIRECTORY "${compiler_target}" PROPERTY "${property}" SET)
                if(source_set)
                    get_source_file_property(source_value "${source}" TARGET_DIRECTORY "${compiler_target}" "${property}")
                    string(APPEND configuration "source=${relative}|${property}=$<TARGET_GENEX_EVAL:${compiler_target},${source_value}>\n")
                endif()
            endforeach()
        endforeach()
    endforeach()
    set(configuration_file "${CMAKE_CURRENT_BINARY_DIR}/${target}-shader-configuration-$<CONFIG>.txt")
    file(GENERATE OUTPUT "${configuration_file}" CONTENT "${configuration}" TARGET "${target}")
    set(BB_SHADER_SOURCE_ROOT "${source_root}")
    set(BB_SHADER_BUILD_ROOT "${CMAKE_CURRENT_BINARY_DIR}")
    set(BB_SHADER_INPUT_SOURCES "${FP_SOURCES}")
    set(BB_SHADER_FINGERPRINT_MODULE "${CMAKE_CURRENT_FUNCTION_LIST_FILE}")
    set(driver "${CMAKE_CURRENT_BINARY_DIR}/${target}-shader-fingerprint.cmake")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ShaderFingerprintDriver.cmake.in" "${driver}" @ONLY)
    add_custom_command(OUTPUT "${output_file}"
        COMMAND "${CMAKE_COMMAND}" "-DBB_SHADER_CONFIGURATION_FILE=${configuration_file}"
            "-DBB_SHADER_OUTPUT_FILE=${output_file}" -P "${driver}"
        DEPENDS ${FP_SOURCES} "${configuration_file}" "${driver}"
            "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" VERBATIM)
    add_custom_target(${target}-shader-identity DEPENDS "${output_file}")
    add_dependencies(${target} ${target}-shader-identity)
endfunction()
